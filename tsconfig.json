{
  "compilerOptions": {
    "target": "es2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    /* TypeScript 6 no longer includes every @types package by default */
    "types": ["jquery", "lodash", "qunit", "three"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    /* TypeScript 6 checks side-effect imports by default, which flags the CSS imports */
    "noUncheckedSideEffectImports": false,
    /* Enabled by `strict` since TypeScript 5.6; the code relies on `set.values().next().value` being non-optional */
    "strictBuiltinIteratorReturn": false
  },
  "include": ["src"]
}
